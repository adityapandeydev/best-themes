{
  "name": "best-themes",
  "displayName": "Best Themes",
  "description": "A curated cross-editor theme collection with visual consistency across VS Code, Zed, and Neovim.",
  "version": "0.1.0",
  "publisher": "adityapandeydev",
  "author": "Aditya Pandey",
  "license": "MIT",
  "engines": {
    "vscode": "^1.67.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "tokyo-night",
    "best-themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adityapandeydev/best-themes"
  },
  "bugs": {
    "url": "https://github.com/adityapandeydev/best-themes/issues"
  },
  "contributes": {
    "themes": [
      {
        "label": "Best Theme - Tokyo Night Enhanced",
        "uiTheme": "vs-dark",
        "path": "./themes/tokyo-night-enhanced.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "rust.injection",
        "path": "./syntaxes/rust-impl.json",
        "injectTo": [
          "source.rust"
        ]
      }
    ]
  }
}
